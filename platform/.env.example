# Copy to a secret deployment environment; NEVER commit live credentials.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-unique-50-plus-character-random-secret
DJANGO_ALLOWED_HOSTS=attendly.yourcompany.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://attendly.yourcompany.com
DATABASE_URL=postgresql://attendly:password@db:5432/attendly
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_EMAIL_HOST=smtp.yourprovider.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_FROM=no-reply@yourcompany.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
